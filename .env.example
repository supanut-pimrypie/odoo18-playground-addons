# central postgres: the postgres_db container, published on the host
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=change_me
DB_NAME=odoo18_playground

# Modules to upgrade on the next container start, e.g. "core_api". A start is a
# fresh python process, so this is what picks up model and field changes.
# Set it, "docker compose up -d --force-recreate odoo", then clear it again.
ODOO_UPDATE=

# Local development only - leave EMPTY everywhere else. "xml" reads views from
# the files instead of the database. "reload" is useless on Docker Desktop for
# Windows: the bind mount does not deliver file events into the container.
# Dev mode also disables asset minification and shows tracebacks in the browser.
ODOO_DEV=

ODOO_PORT=8069
ODOO_GEVENT_PORT=8072
