<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_gc_api_log" model="ir.cron">
        <field name="name">API Log: remove old entries</field>
        <field name="model_id" ref="model_core_api_log"/>
        <field name="state">code</field>
        <field name="code">model._gc_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True"/>
    </record>

    <record id="param_log_retention_days" model="ir.config_parameter">
        <field name="key">core_api.log_retention_days</field>
        <field name="value">30</field>
    </record>
    <record id="param_inbound_enabled" model="ir.config_parameter">
        <field name="key">core_api.inbound_enabled</field>
        <field name="value">True</field>
    </record>

    <record id="param_outbound_enabled" model="ir.config_parameter">
        <field name="key">core_api.outbound_enabled</field>
        <field name="value">True</field>
    </record>
</odoo>
