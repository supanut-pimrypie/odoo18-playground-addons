<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_backup" model="ir.cron">
        <field name="name">Backup: dump database and filestore</field>
        <field name="model_id" ref="model_core_backup"/>
        <field name="state">code</field>
        <field name="code">model._run_backup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- 02:00 server time; ir.cron reads nextcall as UTC -->
        <field name="nextcall"
               eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
        <field name="active" eval="True"/>
    </record>

    <record id="param_enabled" model="ir.config_parameter">
        <field name="key">core_backup.enabled</field>
        <field name="value">True</field>
    </record>

    <record id="param_dir" model="ir.config_parameter">
        <field name="key">core_backup.dir</field>
        <field name="value">/var/lib/odoo/backups</field>
    </record>

    <record id="param_retention_days" model="ir.config_parameter">
        <field name="key">core_backup.retention_days</field>
        <field name="value">14</field>
    </record>

    <record id="param_with_filestore" model="ir.config_parameter">
        <field name="key">core_backup.with_filestore</field>
        <field name="value">True</field>
    </record>
</odoo>
